# Copy this file to .env and fill it in. NEVER commit .env (it is git-ignored).
# Easiest: run `npm run setup` and it writes .env for you.

# Neon: project -> Connect -> turn ON "Show password" -> copy the string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# The address shown in the browser bar (dev: Vite; production: your Vercel URL)
BETTER_AUTH_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173

PORT=4000

# Optional
# NODE_ENV=production
# RESEARCH_AUTO_SETUP=off
# RESEARCH_AUTO_IMPORT=off
# CONTACT_EMAIL=you@example.com

# --- Stripe (TEST mode only: keys start with sk_test_) ---
# dashboard.stripe.com -> make sure the "Test mode" switch is ON -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=sk_test_replace_me
# Local dev: printed by `stripe listen --forward-to localhost:4000/api/stripe/webhook`
# Live site: Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_replace_me
